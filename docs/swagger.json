{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Веб-сервис для учёта электрических приборов, расчёта электрического тока и публикации услуг.",
        "title": "PowerCheck API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/auth/login": {
            "post": {
                "description": "Проверка логина и пароля с выдачей JWT",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Аутентификация"
                ],
                "summary": "Аутентификация пользователя",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "credentials",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ds.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректный запрос",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Неверный логин или пароль",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Отзыв текущего JWT через Redis blacklist. Ответ без тела.",
                "tags": [
                    "Аутентификация"
                ],
                "summary": "Выход из системы",
                "responses": {
                    "200": {
                        "description": "Успешный выход",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Требуется авторизация",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "503": {
                        "description": "Redis недоступен",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/electricity_consumers": {
            "get": {
                "description": "Получение опубликованных услуг с фильтрацией по мощности",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги"
                ],
                "summary": "Получение списка электрических приборов",
                "parameters": [
                    {
                        "type": "number",
                        "description": "Минимальная мощность, кВт",
                        "name": "min_power",
                        "in": "query"
                    },
                    {
                        "type": "number",
                        "description": "Максимальная мощность, кВт",
                        "name": "max_power",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ds.ElectricityConsumerResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректный диапазон",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Ошибка сервера",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Создание черновика с изображением и видео. Создатель определяется по JWT.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги"
                ],
                "summary": "Создание новой услуги",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название электроприбора",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Изображение",
                        "name": "image",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Видео",
                        "name": "video",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/ds.ElectricityConsumerResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректные данные",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Требуется авторизация",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "Черновик уже существует",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/electricity_consumers/draft": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Получение черновика текущего авторизованного пользователя",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги"
                ],
                "summary": "Получение черновика",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.ElectricityConsumerResponse"
                        }
                    },
                    "401": {
                        "description": "Требуется авторизация",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Черновик не найден",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/electricity_consumers/feed/{id}": {
            "get": {
                "description": "Получение опубликованной услуги по ID или следующей услуги при next=true",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Лента"
                ],
                "summary": "Получение ленты",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID услуги",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "description": "Перейти к следующей услуге",
                        "name": "next",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.ElectricityConsumerFeedResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректный ID",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Услуга не найдена",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/electricity_consumers/{id}": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Обновление описания и мощности с расчётом силы тока. Публикация доступна создателю.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги"
                ],
                "summary": "Публикация услуги",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID черновика",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Описание и мощность",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ds.PublishElectricityConsumerRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.ElectricityConsumerResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректный запрос или публикация невозможна",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Требуется авторизация",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Логическое удаление опубликованной услуги создателем",
                "tags": [
                    "Услуги"
                ],
                "summary": "Удаление своей услуги",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID услуги",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешное удаление",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Требуется авторизация",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "Услуга не найдена или не принадлежит пользователю",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/electricity_consumers/{id}/likes": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Значение value=1 ставит лайк, value=0 снимает лайк",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги"
                ],
                "summary": "Установка или снятие лайка",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID услуги",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Значение лайка",
                        "name": "data",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ds.LikeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.ElectricityConsumerResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректные данные",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Требуется авторизация",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/users": {
            "post": {
                "description": "Создание нового пользователя с логином и паролем",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Регистрация пользователя",
                "parameters": [
                    {
                        "description": "Данные пользователя",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ds.RegisterUserRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/ds.UserResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректный запрос",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "Логин уже существует",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "ds.ElectricityConsumerFeedResponse": {
            "type": "object",
            "properties": {
                "current_a": {
                    "type": "number"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image": {
                    "type": "string"
                },
                "is_liked": {
                    "type": "integer"
                },
                "likes_count": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "power_kw": {
                    "type": "number"
                },
                "video": {
                    "type": "string"
                }
            }
        },
        "ds.ElectricityConsumerResponse": {
            "type": "object",
            "properties": {
                "current_a": {
                    "type": "number"
                },
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "image": {
                    "type": "string"
                },
                "is_creator": {
                    "type": "integer"
                },
                "likes_count": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "power_kw": {
                    "type": "number"
                },
                "video": {
                    "type": "string"
                }
            }
        },
        "ds.LikeRequest": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "integer"
                }
            }
        },
        "ds.LoginRequest": {
            "type": "object",
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "ds.LoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer"
                },
                "token_type": {
                    "type": "string"
                }
            }
        },
        "ds.PublishElectricityConsumerRequest": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "power_kw": {
                    "type": "number"
                }
            }
        },
        "ds.RegisterUserRequest": {
            "type": "object",
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "ds.UserResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "login": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Введите Bearer и JWT-токен через пробел",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}